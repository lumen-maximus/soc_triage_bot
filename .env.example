# SOC Triage Bot - Environment Configuration Example
# Copy this file to .env and fill in your actual values

# =============================================================================
# AI/LLM Provider Settings
# =============================================================================
AI_ENABLED=false
AI_PROVIDER=mock  # mock, openai, anthropic, ollama
AI_MODEL=gpt-4o
AI_API_KEY_ENV=OPENAI_API_KEY  # Name of env var containing API key
AI_ENDPOINT=  # Custom endpoint for Ollama/Azure
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
AI_TIMEOUT=30
AI_CACHE_ENABLED=false
AI_PROMPTS_VERSION=1.0.0

# Actual API keys (referenced by AI_API_KEY_ENV above)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# =============================================================================
# SIEM Adapter Settings (Splunk, QRadar, Sentinel, etc.)
# =============================================================================
SIEM_ENABLED=false
SIEM_PROVIDER=mock  # mock, splunk, qradar, sentinel, elasticsearch
SIEM_API_URL=https://splunk.company.com:8089
SIEM_API_KEY_ENV=SIEM_API_KEY
SIEM_USERNAME_ENV=SIEM_USERNAME
SIEM_PASSWORD_ENV=SIEM_PASSWORD
SIEM_TIMEOUT=30
SIEM_VERIFY_SSL=true
SIEM_DEFAULT_INDEX=main
SIEM_MAX_RESULTS=1000
SIEM_SEARCH_TIMEOUT=60

# SIEM credentials
SIEM_API_KEY=your-siem-api-key
SIEM_USERNAME=admin
SIEM_PASSWORD=your-siem-password

# =============================================================================
# EDR Adapter Settings (CrowdStrike, Carbon Black, SentinelOne, etc.)
# =============================================================================
EDR_ENABLED=false
EDR_PROVIDER=mock  # mock, crowdstrike, carbonblack, sentinelone
EDR_API_URL=https://api.crowdstrike.com
EDR_CLIENT_ID_ENV=EDR_CLIENT_ID
EDR_CLIENT_SECRET_ENV=EDR_CLIENT_SECRET
EDR_API_KEY_ENV=EDR_API_KEY
EDR_TIMEOUT=30
EDR_VERIFY_SSL=true
EDR_TENANT_ID=
EDR_MAX_HOSTS=100
EDR_LOOKBACK_HOURS=24

# EDR credentials
EDR_CLIENT_ID=your-edr-client-id
EDR_CLIENT_SECRET=your-edr-client-secret
EDR_API_KEY=your-edr-api-key

# =============================================================================
# Threat Intelligence Settings (Multi-feed support)
# =============================================================================
TI_ENABLED=false

# VirusTotal
TI_VT_ENABLED=false
TI_VT_API_KEY_ENV=VIRUSTOTAL_API_KEY
VIRUSTOTAL_API_KEY=your-virustotal-api-key

# AlienVault OTX
TI_AV_ENABLED=false
TI_AV_API_KEY_ENV=ALIENVAULT_API_KEY
ALIENVAULT_API_KEY=your-alienvault-otx-key

# AbuseIPDB
TI_ABUSE_ENABLED=false
TI_ABUSE_API_KEY_ENV=ABUSEIPDB_API_KEY
ABUSEIPDB_API_KEY=your-abuseipdb-key

# Custom TI feed
TI_CUSTOM_URL=
TI_CUSTOM_API_KEY_ENV=TI_CUSTOM_API_KEY
TI_CUSTOM_API_KEY=

# Configuration
TI_TIMEOUT=30
TI_CACHE_TTL_HOURS=24
TI_MAX_INDICATORS=100

# =============================================================================
# CMDB Adapter Settings (ServiceNow, Device42, etc.)
# =============================================================================
CMDB_ENABLED=false
CMDB_PROVIDER=mock  # mock, servicenow, device42, custom
CMDB_API_URL=https://company.service-now.com/api
CMDB_USERNAME_ENV=CMDB_USERNAME
CMDB_PASSWORD_ENV=CMDB_PASSWORD
CMDB_API_KEY_ENV=CMDB_API_KEY
CMDB_TIMEOUT=30
CMDB_VERIFY_SSL=true
CMDB_ASSET_TABLE=cmdb_ci
CMDB_MAX_RESULTS=100

# CMDB credentials
CMDB_USERNAME=admin
CMDB_PASSWORD=your-cmdb-password
CMDB_API_KEY=your-cmdb-api-key

# =============================================================================
# Vulnerability Adapter Settings (NVD, Tenable, Qualys, etc.)
# =============================================================================
VULN_ENABLED=false
VULN_PROVIDER=mock  # mock, nvd, tenable, qualys

# NVD settings
VULN_NVD_ENABLED=true
VULN_NVD_API_KEY_ENV=NVD_API_KEY
NVD_API_KEY=your-nvd-api-key

# Tenable settings
VULN_TENABLE_ENABLED=false
VULN_TENABLE_ACCESS_ENV=TENABLE_ACCESS_KEY
VULN_TENABLE_SECRET_ENV=TENABLE_SECRET_KEY
TENABLE_ACCESS_KEY=your-tenable-access-key
TENABLE_SECRET_KEY=your-tenable-secret-key

# Generic settings
VULN_API_URL=
VULN_TIMEOUT=30
VULN_CACHE_TTL_HOURS=168  # 7 days

# =============================================================================
# SOAR Adapter Settings (Phantom, XSOAR, Swimlane, etc.)
# =============================================================================
SOAR_ENABLED=false
SOAR_PROVIDER=mock  # mock, phantom, xsoar, swimlane
SOAR_API_URL=https://phantom.company.com
SOAR_API_TOKEN_ENV=SOAR_API_TOKEN
SOAR_USERNAME_ENV=SOAR_USERNAME
SOAR_PASSWORD_ENV=SOAR_PASSWORD
SOAR_TIMEOUT=30
SOAR_VERIFY_SSL=true
SOAR_CONTAINER_PREFIX=SOAR
SOAR_AUTO_CREATE=false

# SOAR credentials
SOAR_API_TOKEN=your-soar-api-token
SOAR_USERNAME=admin
SOAR_PASSWORD=your-soar-password

# =============================================================================
# Database Settings
# =============================================================================
CACHE_ENABLED=false
CACHE_PATH=soc_triage_bot/data/cache.db
CACHE_TTL_HOURS=24

# =============================================================================
# Logging Settings
# =============================================================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_JSON=false

# =============================================================================
# Action Proposal Settings
# =============================================================================
ACTION_TOP_MIN=3
ACTION_TOP_MAX=6
ACTION_FULL_PLAN_MAX=15
ACTION_MIN_SIMILARITY=0.75
ACTION_MAX_CASE_AGE_DAYS=90
ACTION_REQUIRE_SUCCESS=true
ACTION_ENABLE_RUNBOOKS=true
ACTION_ENABLE_HARVESTER=true
ACTION_ENABLE_LEARNED=true
ACTION_ENABLE_CONTEXTUAL=true
ACTION_ENABLE_TEMPLATES=true
ACTION_BLOCK_CONTAINMENT_FP=true
ACTION_REQUIRE_APPROVAL_UNKNOWN=true
ACTION_MIN_CONFIDENCE_AUTO=0.5

# =============================================================================
# Feature Flags
# =============================================================================
FORECAST_ENABLED=true
SIMILARITY_ENABLED=true
CASE_HARVESTING_ENABLED=true
